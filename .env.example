# Copy to .env and adjust. Compose will pick these up automatically.

# BigQuery
BQ_PROJECT_ID=your-gcp-project
BQ_DATASET=smart_plant

# Gemini (vision predict endpoint)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# GCS image storage (optional — leave blank to skip upload)
GCS_BUCKET=your-gcs-bucket
GCS_PREFIX=plant-images
GCP_SERVICE_ACCOUNT_FILE=secrets/gcp-secrets.json
